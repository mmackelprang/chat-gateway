# Copy to .env (gitignored). Never commit real values.
#
# ⚠ The line above used to end "...; on the appserver these live in
# /srv/chat-gateway/.env (mode 600) with pointers in homelab SECRETS.md." That
# named the WRONG HOST, and it did so in the file an operator opens FIRST.
# Corrected 2026-08-03 (CG-53) — the same correction this change made in
# CLAUDE.md's deploy-target bullet and in docker-compose.yml's header, so the
# repo stops asserting both facts at once. The target is the NAS, as a TrueNAS
# CUSTOM APP. The homelab conventions still apply (off-repo file, mode 600,
# SECRETS.md pointers); only the host and the mechanism changed, which is
# exactly why a silent path swap would have read as harmless.
#
# The on-box layout has ONE home and it is not here: docs/deploy/nas.md — §3
# the tree, §5 the compose document, §6 what differs from the dev box and how
# this file gets there. Do not copy the tree or the mode table into this file;
# a second copy of a moving fact is how the sentence above went stale.
#
# LOCAL verification uses this same file — see docs/google-cloud-setup.md §8a.
# A webhook URL embeds key+token and IS a credential: it belongs in .env and
# nowhere else. Never a command-line argument, a chat message, an AI-assistant
# prompt, or a shell-history line. (2026-07-29: that mistake burned every
# webhook in the project and each one had to be recreated by hand.)

# --- gateway ---
CHAT_GATEWAY_REGISTRY=config/registry.yaml   # identities + apps config
CHAT_GATEWAY_PORT=8085
CHAT_GATEWAY_INBOX_DIR=inbox-data            # JSONL audit trail of inbound replies
# How long a day-file in the directory above is kept, in DAYS. It holds a
# human's message text, sender_email and whole raw event, so "forever" was a v0
# over-promise (ADR-0002 D5) and the integration guide's "never pruned" was
# amended to say this instead. 0 DISABLES pruning and restores the old
# behaviour exactly, without a code change. The gateway's own `_unrouted`
# bucket takes a 7-day floor regardless — it answers to no tenant.
# A malformed value falls back to the default and says so on the console; a
# boot that refuses to start over a typo in a retention knob is the worse
# outcome. A sweep dir overlapping the quarantine does NOT fall back — it
# refuses to boot, because that mistake deletes the only copy of replies that
# were never delivered.
CHAT_GATEWAY_INBOX_RETENTION_DAYS=30         # 0 disables; _unrouted floors at 7


CHAT_GATEWAY_STATE_DIR=state                 # heartbeat checks + delivery audit JSONL

# Set on the NAS deployment ONLY. Names a file (mode 600, off-repo) holding every
# secret below, so the container's compose document carries PATHS and nothing
# else. THE ENVIRONMENT WINS: a key already set is never replaced by the file.
# A path that cannot be read is a startup failure, not a warning — a gateway with
# no credentials looks alive on an unauthenticated /healthz.
# Unset locally; this file IS the local path.
CHAT_GATEWAY_ENV_FILE=

# --- per-app API keys (mint with: python3 -m chat_gateway mint-key) ---
# One env var per registered app; the registry's key_env fields name these.
CHAT_GATEWAY_API_KEY__AITEAM_HARNESS=
CHAT_GATEWAY_API_KEY__JOB_HUNTER=
CHAT_GATEWAY_API_KEY__AITRADER=

# --- tier 1: named-webhook identities (URLs embed key+token — secrets) ---
# One env var per webhook identity; registry webhook_url_env fields name these.
GOOGLE_CHAT_WEBHOOK_URL__FAMILYWORKSPACE__PM=
GOOGLE_CHAT_WEBHOOK_URL__JOB_HUNTER=
GOOGLE_CHAT_WEBHOOK_URL__AITRADER_ALERTS=    # phone-visible space
GOOGLE_CHAT_WEBHOOK_URL__AITRADER_REPORTS=   # quiet reports space

# --- tier 2: two-way Chat app (fill after Google Cloud setup — docs/google-cloud-setup.md) ---
GATEWAY_ENABLE_PUBSUB=0                      # 1 once the subscription exists
GOOGLE_APPLICATION_CREDENTIALS=              # path to the service-account key JSON (mode 600)
CHAT_GATEWAY_PUBSUB_SUBSCRIPTION=            # projects/<PROJECT_ID>/subscriptions/chat-gateway-sub

# What producers must put in a card's onClick.action.function for the tap to
# reach this gateway. Published to opted-in apps on GET /v1/identities so no
# producer hardcodes it — that indirection is what makes changing deployment
# model cost ZERO producer card changes (ADR-0001 D3). Not a secret: topic
# names are classified safe to paste in google-cloud-setup.md step 8.
# The right shape depends on the DEPLOYMENT MODEL, so the rows are dated rather
# than labelled "today" — this block said "add-ons (today)" for a day after
# production stopped being add-ons.
#   classic + Pub/Sub         -> any constant; classic echoes action.function
#     PRODUCTION since            back as action.id and invokes nothing
#     2026-07-29
#   add-ons + Pub/Sub         -> the TOPIC path, projects/<P>/topics/<T>
#     production until            (note: the TOPIC, not the subscription above)
#     2026-07-29
#   HTTP endpoint             -> the endpoint URL, or a function name
# A card still carrying the topic path under classic is HARMLESS, not broken:
# the gateway discards topic-path-shaped values from Google-native sources
# rather than handing a tenant "projects/…/topics/…" as an action name. It
# costs the native identity slot, so the identity then has to ride in
# __cg_action__ — which is why that key is kept (ADR-0001 D2/D3).
CHAT_GATEWAY_INTERACTION_ROUTING_TARGET=     # classic: any constant (ADR-0001 D3)
# Leaving this unset with GATEWAY_ENABLE_PUBSUB=1 DEGRADES /healthz: inbound
# card interactions are impossible, not merely unconfigured (CG-7).

GATEWAY_GCP_BILLING=disabled                 # disabled | enabled | unknown — DECLARED, not
                                             # detected. Surfaced at /healthz so an operator
                                             # knows quota exhaustion will fail CLOSED.
                                             # Not detected because Google's own
                                             # topic/send_request_count read ZERO while a
                                             # message was demonstrably flowing — see the
                                             # "Failure signature" warning in
                                             # docs/google-cloud-setup.md.
